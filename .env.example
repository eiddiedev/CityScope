LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_MS=15000
DEEPSEEK_MAX_CONCURRENCY=2
DEEPSEEK_MAX_TOKENS=1600
CITYSCOPE_SEMANTIC_CACHE=enabled
CITYSCOPE_SEMANTIC_CACHE_PATH=.cache/cityscope-actions-v3.sqlite
