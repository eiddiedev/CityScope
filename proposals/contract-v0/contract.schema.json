{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscope.local/contracts/v0/contract.schema.json",
  "title": "CityScope Contract v0 Proposal",
  "$defs": {
    "JsonValue": { "oneOf": [{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"},{"type":"array","items":{"$ref":"#/$defs/JsonValue"}},{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}] },
    "ActorKind": { "enum": ["agent", "service"] },
    "Permission": { "enum": ["propose", "revise", "recommend", "sign_policy", "sign_company_response", "request_audit", "disclose_fact", "decide_financing", "accept_policy", "withdraw_commitment", "exit_project", "publish_reaction", "coordinate", "audit_policy", "pass", "advance_project"] },
    "UtilityDimension": { "type": "object", "additionalProperties": false, "required": ["dimension", "weight", "direction"], "properties": { "dimension": {"type":"string"}, "weight": {"type":"number","exclusiveMinimum":0,"maximum":1}, "direction": {"enum":["maximize","minimize"]} } },
    "ActorBase": { "type": "object", "required": ["manifestVersion", "actorKind", "agentId", "displayName", "organization", "role", "permissions", "forbidden", "privateFactScopes", "provenance"], "properties": { "manifestVersion": {"const":"0.1"}, "actorKind": {"$ref":"#/$defs/ActorKind"}, "agentId": {"type":"string","minLength":1}, "displayName": {"type":"string"}, "organization": {"enum":["superior","chengdu","chongqing","company","capital","stakeholder","rule_service"]}, "role": {"type":"string"}, "reportsTo": {"type":"string"}, "permissions": {"type":"array","items":{"$ref":"#/$defs/Permission"},"uniqueItems":true}, "forbidden": {"type":"array","items":{"type":"string"}}, "privateFactScopes": {"type":"array","items":{"type":"string"}}, "provenance": {"type":"object","additionalProperties":false,"required":["source","verifiedAt"],"properties":{"source":{"type":"string"},"verifiedAt":{"type":"string","format":"date"}}} } },
    "AgentManifest": { "unevaluatedProperties":false,"allOf": [{"$ref":"#/$defs/ActorBase"},{"type":"object","required":["actorKind","goals","redLines","utility","promptVersion"],"properties":{"actorKind":{"const":"agent"},"goals":{"type":"array","minItems":1,"items":{"type":"string"}},"redLines":{"type":"array","minItems":1,"items":{"type":"string"}},"utility":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/UtilityDimension"}},"promptVersion":{"type":"string","minLength":1}}}] },
    "ServiceManifest": { "unevaluatedProperties":false,"allOf": [{"$ref":"#/$defs/ActorBase"},{"type":"object","required":["actorKind","deterministicResponsibilities"],"properties":{"actorKind":{"const":"service"},"organization":{"const":"rule_service"},"deterministicResponsibilities":{"type":"array","minItems":1,"items":{"type":"string"}}}}] },
    "ActorManifest": { "oneOf": [{"$ref":"#/$defs/AgentManifest"},{"$ref":"#/$defs/ServiceManifest"}] },
    "ResourceKind": { "enum": ["fiscalMillionCny", "landHectares", "factorySqm", "energyMw", "talentHousingUnits"] },
    "ResourceAccount": { "type":"object","additionalProperties":false,"required":["capacity","available","reserved","committed","paid","released"],"properties":{"capacity":{"type":"number","minimum":0},"available":{"type":"number","minimum":0},"reserved":{"type":"number","minimum":0},"committed":{"type":"number","minimum":0},"paid":{"type":"number","minimum":0},"released":{"type":"number","minimum":0}} },
    "ResourceLedger": { "type":"object","additionalProperties":false,"required":["fiscalMillionCny","landHectares","factorySqm","energyMw","talentHousingUnits"],"properties":{"fiscalMillionCny":{"$ref":"#/$defs/ResourceAccount"},"landHectares":{"$ref":"#/$defs/ResourceAccount"},"factorySqm":{"$ref":"#/$defs/ResourceAccount"},"energyMw":{"$ref":"#/$defs/ResourceAccount"},"talentHousingUnits":{"$ref":"#/$defs/ResourceAccount"}} },
    "ResourceCalculation": { "type":"object","additionalProperties":false,"required":["tool","resource","requested","available","reserved","committed","paid","released","remaining","passed","reasonCode","evidence"],"properties":{"tool":{"enum":["fiscal","land_facility","energy","talent_housing"]},"resource":{"$ref":"#/$defs/ResourceKind"},"requested":{"type":"number"},"available":{"type":"number","minimum":0},"reserved":{"type":"number","minimum":0},"committed":{"type":"number","minimum":0},"paid":{"type":"number","minimum":0},"released":{"type":"number","minimum":0},"remaining":{"type":"number"},"passed":{"type":"boolean"},"reasonCode":{"enum":["RESOURCE_OK","RESOURCE_EXCEEDED","INVALID_RESOURCE_REQUEST"]},"evidence":{"type":"array","items":{"type":"string"}}} },
    "Trigger": { "type":"object","additionalProperties":false,"required":["metric","operator","value"],"properties":{"metric":{"enum":["verifiedJobs","verifiedInvestmentMillionCny","bindingOrderRatio","annualOutputMillionCny"]},"operator":{"const":">="},"value":{"type":"number","minimum":0}} },
    "PolicyTerm": { "type":"object","additionalProperties":false,"required":["termId","type"],"properties":{"termId":{"type":"string"},"type":{"enum":["cash_support","land","facility","energy","talent_housing","demo_order","output_floor","jobs_milestone"]},"amountMillionCny":{"type":"number","minimum":0},"quantity":{"type":"number","minimum":0},"trigger":{"$ref":"#/$defs/Trigger"},"deadline":{"type":"string"},"failureAction":{"enum":["cancel_payment","clawback","renegotiate"]}} },
    "PolicyPack": { "type":"object","additionalProperties":false,"required":["policyId","cityId","issuerId","decisionMode","terms","status","auditStatus","resourceCalculations","issuedAtVersion"],"properties":{"policyId":{"type":"string"},"cityId":{"enum":["chengdu","chongqing"]},"issuerId":{"type":"string"},"decisionMode":{"enum":["ACCEPT_INVESTMENT","ACCEPT_FINANCE","COMPROMISE","RETURN_FOR_REVISION"]},"terms":{"type":"array","items":{"$ref":"#/$defs/PolicyTerm"}},"status":{"enum":["issued","accepted","rejected","withdrawn"]},"auditStatus":{"enum":["pending","approved","flagged","repair_required"]},"resourceCalculations":{"type":"array","items":{"$ref":"#/$defs/ResourceCalculation"}},"issuedAtVersion":{"type":"integer","minimum":0}} },
    "CompanyResponse": { "type":"object","additionalProperties":false,"required":["responseId","issuerId","targetPolicyIds","requestedChanges","status"],"properties":{"responseId":{"type":"string"},"issuerId":{"type":"string"},"targetPolicyIds":{"type":"array","items":{"type":"string"}},"requestedChanges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["policyId","termId","requestedValue"],"properties":{"policyId":{"type":"string"},"termId":{"type":"string"},"requestedValue":{"type":"number"}}}},"status":{"enum":["issued","accepted","rejected"]}} },
    "Commitment": { "type":"object","additionalProperties":false,"required":["commitmentId","sourcePolicyId","payer","beneficiary","amountMillionCny","failureAction","status","createdAtVersion","lastCauseId"],"properties":{"commitmentId":{"type":"string"},"sourcePolicyId":{"type":"string"},"payer":{"type":"string"},"beneficiary":{"type":"string"},"amountMillionCny":{"type":"number","minimum":0},"trigger":{"$ref":"#/$defs/Trigger"},"deadline":{"type":"string"},"failureAction":{"enum":["cancel_payment","clawback","renegotiate"]},"status":{"enum":["approved","due","paid","failed","withdrawn"]},"createdAtVersion":{"type":"integer","minimum":0},"lastCauseId":{"type":"string"}} },
    "Fact": { "type":"object","additionalProperties":false,"required":["factId","kind","value","ownerId","visibility","audience"],"properties":{"factId":{"type":"string"},"kind":{"enum":["cash_runway","order_quality","financing_market","policy_capacity"]},"value":{"$ref":"#/$defs/JsonValue"},"ownerId":{"type":"string"},"visibility":{"enum":["private","disclosed"]},"audience":{"type":"array","items":{"type":"string"}},"disclosedAtVersion":{"type":"integer","minimum":0}} },
    "StakeholderState": { "type":"object","additionalProperties":false,"required":["talentAttraction","smeParticipation","supplyChainReadiness","housingPressure","residentSupport","fiscalFairnessConcern","trafficOrEnergyPressure","publicTrust"],"properties":{"talentAttraction":{"type":"number","minimum":0,"maximum":100},"smeParticipation":{"type":"number","minimum":0,"maximum":100},"supplyChainReadiness":{"type":"number","minimum":0,"maximum":100},"housingPressure":{"type":"number","minimum":0,"maximum":100},"residentSupport":{"type":"number","minimum":0,"maximum":100},"fiscalFairnessConcern":{"type":"number","minimum":0,"maximum":100},"trafficOrEnergyPressure":{"type":"number","minimum":0,"maximum":100},"publicTrust":{"type":"number","minimum":0,"maximum":100}} },
    "CityState": { "type":"object","additionalProperties":false,"required":["cityId","fiscal","resources","resourceLedger","policyTools","objectiveWeights","industryGoals","policyCredibility","internalAdvice","policies"],"properties":{"cityId":{"enum":["chengdu","chongqing"]},"fiscal":{"type":"object","additionalProperties":false,"required":["availableMillionCny","committedMillionCny","paidMillionCny"],"properties":{"availableMillionCny":{"type":"number","minimum":0},"committedMillionCny":{"type":"number","minimum":0},"paidMillionCny":{"type":"number","minimum":0}}},"resources":{"type":"object","additionalProperties":false,"required":["landHectares","factorySqm","talentHousingUnits","energyMw"],"properties":{"landHectares":{"type":"number","minimum":0},"factorySqm":{"type":"number","minimum":0},"talentHousingUnits":{"type":"number","minimum":0},"energyMw":{"type":"number","minimum":0}}},"resourceLedger":{"$ref":"#/$defs/ResourceLedger"},"policyTools":{"type":"array","items":{"type":"string"}},"objectiveWeights":{"type":"object","additionalProperties":{"type":"number"}},"industryGoals":{"type":"array","items":{"type":"string"}},"policyCredibility":{"type":"number","minimum":0,"maximum":100},"internalAdvice":{"type":"array","items":{"$ref":"#/$defs/InternalAdvice"}},"policies":{"type":"array","items":{"$ref":"#/$defs/PolicyPack"}}} },
    "InternalAdvice": { "type":"object","additionalProperties":false,"required":["actionId","actorId","proposal"],"properties":{"actionId":{"type":"string"},"actorId":{"type":"string"},"proposal":{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}} },
    "CompanyState": { "type":"object","additionalProperties":false,"required":["cashRunwayMonths","investmentPlanMillionCny","verifiedInvestmentMillionCny","verifiedJobs","annualOutputMillionCny","bindingOrderRatio","projectStage","internalAdvice","responses"],"properties":{"cashRunwayMonths":{"type":"number","minimum":0},"investmentPlanMillionCny":{"type":"number","minimum":0},"verifiedInvestmentMillionCny":{"type":"number","minimum":0},"verifiedJobs":{"type":"number","minimum":0},"annualOutputMillionCny":{"type":"number","minimum":0},"bindingOrderRatio":{"type":"number","minimum":0,"maximum":1},"projectStage":{"enum":["courtship","due_diligence","negotiation","signed","delivery","renegotiation","completed","exited"]},"internalAdvice":{"type":"array","items":{"$ref":"#/$defs/InternalAdvice"}},"responses":{"type":"array","items":{"$ref":"#/$defs/CompanyResponse"}}} },
    "CoordinationOpinion": { "type":"object","additionalProperties":false,"required":["opinionId","actorId","policyIds","recommendation","reasonCodes"],"properties":{"opinionId":{"type":"string"},"actorId":{"const":"regional_coordinator"},"policyIds":{"type":"array","items":{"type":"string"}},"recommendation":{"enum":["split_functions","reduce_duplicate_subsidy","no_coordination_needed"]},"reasonCodes":{"type":"array","items":{"type":"string"}}} },
    "StateDelta": { "type":"object","additionalProperties":false,"required":["deltaId","causeId","path","before","after","actorId","worldVersion"],"properties":{"deltaId":{"type":"string"},"causeId":{"type":"string"},"path":{"type":"string"},"before":{"$ref":"#/$defs/JsonValue"},"after":{"$ref":"#/$defs/JsonValue"},"actorId":{"type":"string"},"worldVersion":{"type":"integer","minimum":1}} },
    "GateResult": { "type":"object","additionalProperties":false,"required":["gate","passed","reason"],"properties":{"gate":{"enum":["schema","authority","constraint","privacy"]},"passed":{"type":"boolean"},"code":{"type":"string"},"reason":{"type":"string"},"calculations":{"type":"array","items":{"$ref":"#/$defs/ResourceCalculation"}}} },
    "Evidence": { "type":"object","additionalProperties":false,"required":["kind","id","digest"],"properties":{"kind":{"enum":["fact","policy","state","action"]},"id":{"type":"string"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}} },
    "DecisionReceipt": { "type":"object","additionalProperties":false,"required":["receiptId","actionId","actorId","status","gateResults","evidence","deltas","worldVersion"],"properties":{"receiptId":{"type":"string"},"actionId":{"type":"string"},"actorId":{"type":"string"},"status":{"enum":["APPLIED","REJECTED"]},"gateResults":{"type":"array","items":{"$ref":"#/$defs/GateResult"}},"evidence":{"type":"array","items":{"$ref":"#/$defs/Evidence"}},"deltas":{"type":"array","items":{"$ref":"#/$defs/StateDelta"}},"worldVersion":{"type":"integer","minimum":0}} },
    "WorldEvent": { "type":"object","additionalProperties":false,"required":["eventId","eventType","causeId","actorId","worldVersion","occurredAt","payload"],"properties":{"eventId":{"type":"string"},"eventType":{"enum":["AgentActionProposed","ActionRejected","PolicyPackIssued","CompanyResponseIssued","FactDisclosed","CommitmentApproved","CommitmentStatusChanged","StateChanged","CheckpointCreated","ForkCreated","SimulationTerminated","OutcomeClassified"]},"causeId":{"type":"string"},"actorId":{"type":"string"},"worldVersion":{"type":"integer","minimum":0},"occurredAt":{"type":"string","format":"date-time"},"payload":{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}} },
    "Outcome": { "type":"object","additionalProperties":false,"required":["label","evidence","classifiedAtVersion"],"properties":{"label":{"enum":["CHENGDU_LED","CHONGQING_LED","DUAL_CITY","PROJECT_EXITED","CONTINUING_COMMITMENTS"]},"evidence":{"type":"array","items":{"type":"string"}},"classifiedAtVersion":{"type":"integer","minimum":0}} },
    "ModelSnapshot": { "type":"object","additionalProperties":false,"required":["provider","model","promptVersions","seed","schemaVersion"],"properties":{"provider":{"type":"string"},"model":{"type":"string"},"promptVersions":{"type":"object","additionalProperties":{"type":"string"}},"seed":{"type":"integer"},"schemaVersion":{"const":"cityscope.contract.v0"}} },
    "SimulationState": { "type":"object","additionalProperties":false,"required":["mode","phase","cycle","outcomeStatus"],"properties":{"mode":{"enum":["autonomous","replay"]},"phase":{"enum":["internal_advice","policy_formation","policy_audit","stakeholder_reaction","company_deliberation","due_diligence","post_disclosure","delivery","delivery_reaction","complete"]},"cycle":{"type":"integer","minimum":0},"outcomeStatus":{"enum":["pending","classified"]},"classification":{"$ref":"#/$defs/Outcome"}} },
    "Intervention": { "type":"object","additionalProperties":false,"required":["interventionId","path","previousValue","newValue","reason"],"properties":{"interventionId":{"type":"string"},"path":{"type":"string"},"previousValue":{"$ref":"#/$defs/JsonValue"},"newValue":{"$ref":"#/$defs/JsonValue"},"reason":{"type":"string"}} },
    "WorldState": { "type":"object","additionalProperties":false,"required":["scenarioId","runId","worldVersion","round","terminal","metrics","stakeholders","coordinationOpinions","cities","company","facts","commitments","agentMemory","events","receipts","trace","snapshot","simulation"],"properties":{"scenarioId":{"type":"string"},"runId":{"type":"string"},"parentRunId":{"type":"string"},"interventionId":{"type":"string"},"intervention":{"$ref":"#/$defs/Intervention"},"worldVersion":{"type":"integer","minimum":0},"round":{"type":"integer","minimum":1},"terminal":{"type":"boolean"},"terminalReason":{"type":"string"},"metrics":{"type":"object","additionalProperties":false,"required":["trust","financingConfidence","projectViability"],"properties":{"trust":{"type":"number","minimum":0,"maximum":100},"financingConfidence":{"type":"number","minimum":0,"maximum":100},"projectViability":{"type":"number","minimum":0,"maximum":100}}},"stakeholders":{"$ref":"#/$defs/StakeholderState"},"coordinationOpinions":{"type":"array","items":{"$ref":"#/$defs/CoordinationOpinion"}},"cities":{"type":"object","additionalProperties":false,"required":["chengdu","chongqing"],"properties":{"chengdu":{"$ref":"#/$defs/CityState"},"chongqing":{"$ref":"#/$defs/CityState"}}},"company":{"$ref":"#/$defs/CompanyState"},"facts":{"type":"array","items":{"$ref":"#/$defs/Fact"}},"commitments":{"type":"array","items":{"$ref":"#/$defs/Commitment"}},"agentMemory":{"type":"object","additionalProperties":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["causeId","summary"],"properties":{"causeId":{"type":"string"},"summary":{"type":"string"}}}}},"events":{"type":"array","items":{"$ref":"#/$defs/WorldEvent"}},"receipts":{"type":"array","items":{"$ref":"#/$defs/DecisionReceipt"}},"trace":{"type":"array","items":{"$ref":"#/$defs/StateDelta"}},"snapshot":{"$ref":"#/$defs/ModelSnapshot"},"simulation":{"$ref":"#/$defs/SimulationState"}} },
    "Checkpoint": { "type":"object","additionalProperties":false,"required":["checkpointId","sourceRunId","createdAtVersion","digest","state"],"properties":{"checkpointId":{"type":"string"},"sourceRunId":{"type":"string"},"createdAtVersion":{"type":"integer","minimum":0},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"state":{"$ref":"#/$defs/WorldState"}} },
    "PolicyDraftPayload": { "type":"object","additionalProperties":false,"required":["policyId","cityId","decisionMode","terms"],"properties":{"policyId":{"type":"string"},"cityId":{"enum":["chengdu","chongqing"]},"decisionMode":{"enum":["ACCEPT_INVESTMENT","ACCEPT_FINANCE","COMPROMISE","RETURN_FOR_REVISION"]},"terms":{"type":"array","items":{"$ref":"#/$defs/PolicyTerm"}}} },
    "AdvicePolicyPayload": { "type":"object","additionalProperties":false,"properties":{"supportMillionCny":{"type":"number"},"supportPreferenceMillionCny":{"type":"number"},"maxSupportMillionCny":{"type":"number"},"maxFiscalMillionCny":{"type":"number"},"cashSupportMillionCny":{"type":"number"},"maxCashMillionCny":{"type":"number"},"upfrontRatio":{"type":"number"},"factorySqm":{"type":"number"},"energyMw":{"type":"number"},"talentHousingUnits":{"type":"number"},"annualOutputFloorMillionCny":{"type":"number"},"outputFloorMillionCny":{"type":"number"},"equipmentSupport":{"type":"boolean"},"requireMilestones":{"type":"boolean"},"requireOutputFloor":{"type":"boolean"},"instruments":{"type":"array","items":{"type":"string"}},"requestedLanding":{"type":"array","items":{"type":"string"}},"requestedFunctions":{"type":"array","items":{"type":"string"}},"milestones":{"type":"array","items":{"type":"string"}}},"minProperties":1 },
    "AdviceCompanyPayload": { "type":"object","additionalProperties":false,"properties":{"preference":{"type":"string"},"stance":{"type":"string"},"preferredCapability":{"type":"string"},"targetInvestmentMillionCny":{"type":"number"},"requireUpfrontCash":{"type":"boolean"},"maxRigidOutputMillionCny":{"type":"number"},"minUpfrontMillionCny":{"type":"number"},"rationale":{"type":"array","items":{"type":"string"}},"requests":{"type":"array","items":{"type":"string"}}},"minProperties":1 },
    "RequestedChange": { "type":"object","additionalProperties":false,"required":["policyId","termId","requestedValue"],"properties":{"policyId":{"type":"string"},"termId":{"type":"string"},"requestedValue":{"type":"number"}} },
    "ActionEnvelope": { "type":"object","required":["actionId","actorId","kind","reasoning","payload","evidenceFactIds","promptVersion","schemaVersion"],"properties":{"actionId":{"type":"string"},"actorId":{"type":"string"},"kind":{"type":"string"},"reasoning":{"type":"string","minLength":1},"payload":{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}},"evidenceFactIds":{"type":"array","items":{"type":"string"}},"promptVersion":{"type":"string"},"schemaVersion":{"const":"cityscope.contract.v0"}} },
    "AgentAction": { "oneOf": [
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"ADVISE_POLICY"},"payload":{"$ref":"#/$defs/AdvicePolicyPayload"}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"SUBMIT_POLICY_PACK"},"payload":{"$ref":"#/$defs/PolicyDraftPayload"}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"ADVISE_COMPANY_RESPONSE"},"payload":{"$ref":"#/$defs/AdviceCompanyPayload"}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"SUBMIT_COMPANY_RESPONSE"},"payload":{"type":"object","additionalProperties":false,"required":["responseId","targetPolicyIds","requestedChanges"],"properties":{"responseId":{"type":"string"},"targetPolicyIds":{"type":"array","items":{"type":"string"}},"requestedChanges":{"type":"array","items":{"$ref":"#/$defs/RequestedChange"}}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"ADVISE_FINANCING"},"payload":{"type":"object","additionalProperties":false,"required":["stance"],"properties":{"stance":{"enum":["withhold","conditional","support"]},"condition":{"type":"string"}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"REQUEST_DUE_DILIGENCE"},"payload":{"type":"object","additionalProperties":false,"required":["scope","round"],"properties":{"scope":{"type":"array","items":{"type":"string"}},"round":{"type":"integer","minimum":2}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"DISCLOSE_FACT"},"payload":{"type":"object","additionalProperties":false,"required":["factId","audience"],"properties":{"factId":{"type":"string"},"audience":{"type":"array","items":{"type":"string"}}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"enum":["ACCEPT_POLICY","REJECT_POLICY"]},"payload":{"type":"object","additionalProperties":false,"required":["policyId"],"properties":{"policyId":{"type":"string"}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"WITHDRAW_COMMITMENT"},"payload":{"type":"object","additionalProperties":false,"required":["commitmentId"],"properties":{"commitmentId":{"type":"string"}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"EXIT_PROJECT"},"payload":{"type":"object","additionalProperties":false,"required":["reasonCode"],"properties":{"reasonCode":{"type":"string"}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"ADVANCE_PROJECT"},"payload":{"type":"object","additionalProperties":false,"properties":{"verifiedInvestmentMillionCny":{"type":"number"},"verifiedJobs":{"type":"number"},"annualOutputMillionCny":{"type":"number"},"failedCommitmentIds":{"type":"array","items":{"type":"string"}}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"PUBLISH_STAKEHOLDER_REACTION"},"payload":{"type":"object","additionalProperties":false,"required":["reactionId","metrics","reasonCodes","sentiment"],"properties":{"reactionId":{"type":"string"},"metrics":{"type":"object","additionalProperties":{"type":"number","minimum":-15,"maximum":15}},"reasonCodes":{"type":"array","minItems":1,"items":{"type":"string"}},"sentiment":{"enum":["support","concern","mixed"]}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"ISSUE_COORDINATION_OPINION"},"payload":{"type":"object","additionalProperties":false,"required":["opinionId","policyIds","recommendation","reasonCodes"],"properties":{"opinionId":{"type":"string"},"policyIds":{"type":"array","items":{"type":"string"}},"recommendation":{"enum":["split_functions","reduce_duplicate_subsidy","no_coordination_needed"]},"reasonCodes":{"type":"array","items":{"type":"string"}}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"AUDIT_POLICY_PACK"},"payload":{"type":"object","additionalProperties":false,"required":["audits"],"properties":{"audits":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["policyId","decision","reasonCodes"],"properties":{"policyId":{"type":"string"},"decision":{"enum":["approve","flag","require_repair"]},"reasonCodes":{"type":"array","items":{"type":"string"}}}}}}}}}]},
      {"unevaluatedProperties":false,"allOf":[{"$ref":"#/$defs/ActionEnvelope"},{"type":"object","properties":{"kind":{"const":"PASS"},"payload":{"type":"object","additionalProperties":false,"required":["phase","reasonCode"],"properties":{"phase":{"type":"string"},"reasonCode":{"type":"string"}}}}}]}
    ] },
    "SemanticEffects": { "type":"object","additionalProperties":false,"required":["projectTendency","researchBuildingStage","factoryStage","talentFlow","logisticsFlow","housingSignal","residentSignal","resourceAlerts"],"properties":{"projectTendency":{"enum":["pending","chengdu_research","chongqing_manufacturing","dual_city_split","exit_risk"]},"researchBuildingStage":{"enum":["idle","planned","construction","operating"]},"factoryStage":{"enum":["idle","planned","construction","operating"]},"talentFlow":{"enum":["outflow_risk","stable","inflow"]},"logisticsFlow":{"enum":["idle","preparing","active"]},"housingSignal":{"enum":["normal","tight","critical"]},"residentSignal":{"enum":["opposed","watching","supportive"]},"resourceAlerts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["cityId","resource","severity","remainingRatio"],"properties":{"cityId":{"enum":["chengdu","chongqing"]},"resource":{"$ref":"#/$defs/ResourceKind"},"severity":{"enum":["warning","critical"]},"remainingRatio":{"type":"number","minimum":0,"maximum":1}}}}} },
    "ApiError": { "type":"object","additionalProperties":false,"required":["error"],"properties":{"error":{"type":"object","additionalProperties":false,"required":["code","message","retryable"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"details":{"$ref":"#/$defs/JsonValue"},"retryable":{"type":"boolean"}}}} },
    "ActionResponse": { "type":"object","additionalProperties":false,"required":["state","receipt","events"],"properties":{"state":{"$ref":"#/$defs/WorldState"},"receipt":{"$ref":"#/$defs/DecisionReceipt"},"events":{"type":"array","items":{"$ref":"#/$defs/WorldEvent"}}} },
    "TraceResponse": { "type":"object","additionalProperties":false,"required":["actionReceipt","events","deltas"],"properties":{"actionReceipt":{"oneOf":[{"$ref":"#/$defs/DecisionReceipt"},{"type":"null"}]},"events":{"type":"array","items":{"$ref":"#/$defs/WorldEvent"}},"deltas":{"type":"array","items":{"$ref":"#/$defs/StateDelta"}}} },
    "WorldStateResponse": { "$ref":"#/$defs/WorldState" },
    "EventListResponse": { "type":"array","items":{"$ref":"#/$defs/WorldEvent"} },
    "CheckpointResponse": { "$ref":"#/$defs/Checkpoint" },
    "ForkResponse": { "$ref":"#/$defs/WorldState" },
    "OutcomeResponse": { "$ref":"#/$defs/Outcome" },
    "HealthResponse": { "type":"object","additionalProperties":false,"required":["ok","provider","model","demoMode"],"properties":{"ok":{"const":true},"provider":{"type":"string"},"model":{"type":"string"},"demoMode":{"type":"boolean"}} },
    "FrontendCompatibilitySample": { "type":"object","additionalProperties":false,"required":["schemaVersion","state","semanticEffects","recentEvents","recentDeltas","resourceGateReceipts"],"properties":{"schemaVersion":{"const":"cityscope.contract.v0"},"state":{"$ref":"#/$defs/WorldState"},"semanticEffects":{"$ref":"#/$defs/SemanticEffects"},"recentEvents":{"type":"array","items":{"$ref":"#/$defs/WorldEvent"}},"recentDeltas":{"type":"array","items":{"$ref":"#/$defs/StateDelta"}},"resourceGateReceipts":{"type":"array","items":{"$ref":"#/$defs/ResourceCalculation"}}} }
  }
}
