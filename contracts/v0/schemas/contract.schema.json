    "CityOfferDecision": { "type":"object","additionalProperties":false,"required":["actionId","kind","candidateId","utility","reservationUtility","utilityGap","reasonCodes","decidedAtVersion"],"properties":{"actionId":{"type":"string"},"kind":{"enum":["maintain","revise","withdraw"]},"candidateId":{"type":"string"},"utility":{"type":"number"},"reservationUtility":{"type":"number"},"utilityGap":{"type":"number"},"reasonCodes":{"type":"array","items":{"type":"string"}},"decidedAtVersion":{"type":"integer","minimum":0}} },
    "CityState": { "type":"object","additionalProperties":false,"required":["cityId","bidStatus","fiscal","resources","resourceLedger","policyTools","objectiveWeights","industryGoals","policyCredibility","internalAdvice","policies","policyRevisions"],"properties":{"cityId":{"enum":["chengdu","chongqing"]},"bidStatus":{"enum":["competing","revising","withdrawn","closed","accepted"]},"fiscal":{"type":"object","additionalProperties":false,"required":["availableMillionCny","committedMillionCny","paidMillionCny"],"properties":{"availableMillionCny":{"type":"number","minimum":0},"committedMillionCny":{"type":"number","minimum":0},"paidMillionCny":{"type":"number","minimum":0}}},"resources":{"type":"object","additionalProperties":false,"required":["landHectares","factorySqm","talentHousingUnits","energyMw"],"properties":{"landHectares":{"type":"number","minimum":0},"factorySqm":{"type":"number","minimum":0},"talentHousingUnits":{"type":"number","minimum":0},"energyMw":{"type":"number","minimum":0}}},"resourceLedger":{"$ref":"#/$defs/ResourceLedger"},"policyTools":{"type":"array","items":{"type":"string"}},"objectiveWeights":{"type":"object","additionalProperties":{"type":"number"}},"industryGoals":{"type":"array","items":{"type":"string"}},"policyCredibility":{"type":"number","minimum":0,"maximum":100},"internalAdvice":{"type":"array","items":{"$ref":"#/$defs/InternalAdvice"}},"policies":{"type":"array","items":{"$ref":"#/$defs/PolicyPack"}},"policyRevisions":{"type":"array","items":{"$ref":"#/$defs/PolicyRevision"}},"offerDecision":{"$ref":"#/$defs/CityOfferDecision"}} },
    "InternalAdvice": { "type":"object","additionalProperties":false,"required":["actionId","actorId","proposal"],"properties":{"actionId":{"type":"string"},"actorId":{"type":"string"},"proposal":{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}} },
    "CompanyState": { "type":"object","additionalProperties":false,"required":["cashRunwayMonths","investmentPlanMillionCny","verifiedInvestmentMillionCny","verifiedJobs","annualOutputMillionCny","bindingOrderRatio","projectStage","internalAdvice","responses"],"properties":{"cashRunwayMonths":{"type":"number","minimum":0},"investmentPlanMillionCny":{"type":"number","minimum":0},"verifiedInvestmentMillionCny":{"type":"number","minimum":0},"verifiedJobs":{"type":"number","minimum":0},"annualOutputMillionCny":{"type":"number","minimum":0},"bindingOrderRatio":{"type":"number","minimum":0,"maximum":1},"projectStage":{"enum":["courtship","due_diligence","negotiation","signed","delivery","renegotiation","completed","exited"]},"internalAdvice":{"type":"array","items":{"$ref":"#/$defs/InternalAdvice"}},"responses":{"type":"array","items":{"$ref":"#/$defs/CompanyResponse"}}} },
    "CoordinationOpinion": { "type":"object","additionalProperties":false,"required":["opinionId","actorId","policyIds","recommendation","reasonCodes"],"properties":{"opinionId":{"type":"string"},"actorId":{"const":"regional_coordinator"},"policyIds":{"type":"array","items":{"type":"string"}},"recommendation":{"enum":["split_functions","reduce_duplicate_subsidy","no_coordination_needed"]},"reasonCodes":{"type":"array","items":{"type":"string"}},"threadId":{"type":"string"},"summary":{"type":"string"},"concessions":{"type":"array","items":{"type":"string"}}} },
