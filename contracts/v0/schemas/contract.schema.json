    "FinalDecision": { "type":"object","additionalProperties":false,"required":["decisionId","type","actorId","decidedAtVersion","causeId"],"properties":{"decisionId":{"type":"string"},"type":{"enum":["single_city","coordination","regional_exit"]},"cityId":{"enum":["chengdu","chongqing"]},"policyId":{"type":"string"},"coordinationPlanId":{"type":"string"},"actorId":{"const":"company_board"},"decidedAtVersion":{"type":"integer","minimum":0},"causeId":{"type":"string"}} },
    "ImpactAssessment": { "type":"object","additionalProperties":false,"required":["horizonMonths","actualInvestmentMillionCny","actualJobs","orderConversionRatio","capacityUtilization","subsidyPaidMillionCny","subsidyCancelledMillionCny","subsidyClawedBackMillionCny","fiscalPressure","smeCrowdingOut","talentPressure","housingPressure","governmentCredibility","publicTrust","policySuccess","evidence","assessedAtVersion"],"properties":{"horizonMonths":{"enum":[12,24]},"actualInvestmentMillionCny":{"type":"number","minimum":0},"actualJobs":{"type":"number","minimum":0},"orderConversionRatio":{"type":"number","minimum":0,"maximum":1},"capacityUtilization":{"type":"number","minimum":0,"maximum":1},"subsidyPaidMillionCny":{"type":"number","minimum":0},"subsidyCancelledMillionCny":{"type":"number","minimum":0},"subsidyClawedBackMillionCny":{"type":"number","minimum":0},"fiscalPressure":{"type":"object","additionalProperties":false,"required":["chengdu","chongqing"],"properties":{"chengdu":{"type":"number"},"chongqing":{"type":"number"}}},"smeCrowdingOut":{"type":"number"},"talentPressure":{"type":"number"},"housingPressure":{"type":"number"},"governmentCredibility":{"type":"object","additionalProperties":false,"required":["chengdu","chongqing"],"properties":{"chengdu":{"type":"number"},"chongqing":{"type":"number"}}},"publicTrust":{"type":"number"},"policySuccess":{"enum":["successful","mixed","failed","not_landed"]},"evidence":{"type":"array","items":{"type":"string"}},"assessedAtVersion":{"type":"integer","minimum":0}} },
    "DebateMessage": { "type":"object","additionalProperties":false,"required":["messageId","threadId","actorId","sequence","turnType","issue","stance","content","audience","visibility","createdAtVersion"],"properties":{"messageId":{"type":"string"},"threadId":{"type":"string"},"actorId":{"type":"string"},"sequence":{"type":"integer","minimum":1},"turnType":{"enum":["challenge","position","proposal","counter","concession"]},"issue":{"enum":["functional_allocation","duplicate_subsidy","fiscal_risk"]},"stance":{"enum":["support","oppose","conditional","mediate"]},"content":{"type":"string"},"audience":{"type":"array","items":{"type":"string"}},"visibility":{"enum":["participants","public"]},"replyToMessageId":{"type":"string"},"createdAtVersion":{"type":"integer","minimum":0}} },
    "DebateThread": { "type":"object","additionalProperties":false,"required":["threadId","topic","participantIds","status","messages"],"properties":{"threadId":{"type":"string"},"topic":{"type":"string"},"participantIds":{"type":"array","items":{"type":"string"}},"status":{"enum":["open","resolved","deadlocked"]},"messages":{"type":"array","items":{"$ref":"#/$defs/DebateMessage"}},"resolutionOpinionId":{"type":"string"}} },
    "StateDelta": { "type":"object","additionalProperties":false,"required":["deltaId","causeId","path","before","after","actorId","worldVersion"],"properties":{"deltaId":{"type":"string"},"causeId":{"type":"string"},"path":{"type":"string"},"before":{"$ref":"#/$defs/JsonValue"},"after":{"$ref":"#/$defs/JsonValue"},"actorId":{"type":"string"},"worldVersion":{"type":"integer","minimum":1}} },
    "GateResult": { "type":"object","additionalProperties":false,"required":["gate","passed","reason"],"properties":{"gate":{"enum":["schema","authority","constraint","privacy"]},"passed":{"type":"boolean"},"code":{"type":"string"},"reason":{"type":"string"},"calculations":{"type":"array","items":{"$ref":"#/$defs/ResourceCalculation"}}} },
    "Evidence": { "type":"object","additionalProperties":false,"required":["kind","id","digest"],"properties":{"kind":{"enum":["fact","policy","state","action"]},"id":{"type":"string"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}} },
    "DecisionReceipt": { "type":"object","additionalProperties":false,"required":["receiptId","actionId","actorId","status","gateResults","evidence","deltas","worldVersion"],"properties":{"receiptId":{"type":"string"},"actionId":{"type":"string"},"actorId":{"type":"string"},"status":{"enum":["APPLIED","REJECTED"]},"gateResults":{"type":"array","items":{"$ref":"#/$defs/GateResult"}},"evidence":{"type":"array","items":{"$ref":"#/$defs/Evidence"}},"deltas":{"type":"array","items":{"$ref":"#/$defs/StateDelta"}},"worldVersion":{"type":"integer","minimum":0}} },
    "WorldEvent": { "type":"object","additionalProperties":false,"required":["eventId","eventType","causeId","actorId","worldVersion","occurredAt","payload"],"properties":{"eventId":{"type":"string"},"eventType":{"enum":["AgentActionProposed","ActionRejected","PolicyPackIssued","CompanyResponseIssued","FactDisclosed","DebateMessagePublished","CommitmentApproved","CommitmentStatusChanged","StateChanged","CheckpointCreated","ForkCreated","SimulationTerminated","OutcomeClassified"]},"causeId":{"type":"string"},"actorId":{"type":"string"},"worldVersion":{"type":"integer","minimum":0},"occurredAt":{"type":"string","format":"date-time"},"payload":{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}} },
    "OutcomeBasis": { "type":"object","additionalProperties":false,"required":["decisionType","finalDecisionId","requiredActionIds","approvalIds","causeIds"],"properties":{"decisionType":{"enum":["single_city","coordination","regional_exit"]},"finalDecisionId":{"type":"string"},"requiredActionIds":{"type":"array","items":{"type":"string"}},"approvalIds":{"type":"array","items":{"type":"string"}},"causeIds":{"type":"array","items":{"type":"string"}}} },
    "Outcome": { "type":"object","additionalProperties":false,"required":["label","evidence","classifiedAtVersion"],"properties":{"label":{"enum":["CHENGDU_LED","CHONGQING_LED","DUAL_CITY","PROJECT_EXITED"]},"evidence":{"type":"array","items":{"type":"string"}},"classifiedAtVersion":{"type":"integer","minimum":0},"basis":{"$ref":"#/$defs/OutcomeBasis"}} },
    "ModelSnapshot": { "type":"object","additionalProperties":false,"required":["provider","model","promptVersions","seed","schemaVersion"],"properties":{"provider":{"type":"string"},"model":{"type":"string"},"promptVersions":{"type":"object","additionalProperties":{"type":"string"}},"seed":{"type":"integer"},"schemaVersion":{"const":"cityscope.contract.v0"}} },
    "SimulationState": { "type":"object","additionalProperties":false,"required":["mode","phase","cycle","outcomeStatus"],"properties":{"mode":{"enum":["autonomous","replay"]},"phase":{"enum":["internal_advice","policy_formation","policy_audit","coordination_debate","stakeholder_reaction","company_deliberation","due_diligence","risk_reassessment","policy_revision","coordination_resolution","final_deliberation","post_disclosure","delivery","delivery_reaction","impact_assessment","complete"]},"cycle":{"type":"integer","minimum":0},"outcomeStatus":{"enum":["pending","classified"]},"classification":{"$ref":"#/$defs/Outcome"}} },
