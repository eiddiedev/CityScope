{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityscope.local/contracts/v0/contract.schema.json",
  "title": "CityScope Contract v0 Proposal",
  "$defs": {
    "JsonValue": { "oneOf": [{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"},{"type":"array","items":{"$ref":"#/$defs/JsonValue"}},{"type":"object","additionalProperties":{"$ref":"#/$defs/JsonValue"}}] },
    "ActorKind": { "enum": ["agent", "service"] },
